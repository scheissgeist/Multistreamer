# Server
SERVER_IP=

# Ingest key: the stream key you put in OBS. Anyone who knows it (and your
# server IP) can publish through the relay, so use a long random value:
#   openssl rand -hex 24
# Letters, digits, _ and - only. Defaults to "livestream" if left empty.
INGEST_STREAM_KEY=

# Stream keys
TWITCH_STREAM_KEY=
KICK_STREAM_KEY=
# YOUTUBE_STREAM_KEY=

# Twitch API (run: bash scripts/auth-setup.sh twitch)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_BROADCASTER_ID=

# Kick API (run: bash scripts/auth-setup.sh kick)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_ACCESS_TOKEN=
KICK_REFRESH_TOKEN=
